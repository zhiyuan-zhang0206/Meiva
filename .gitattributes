# Normalize all text files to LF in the repo (Windows checkouts included).
# Prevents the CRLF churn that bloats diffs when edited on Windows.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Parallel pull requests each add a line to this list of path prefixes; keep both sides' lines
# instead of stopping at a conflict. The generator sorts and de-duplicates what it reads (see the
# note at the top of scripts/codegen/gen_pyright_test_environments.py).
scripts/codegen/pyright_tests_owing_any.txt merge=union
