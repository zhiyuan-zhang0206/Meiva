# Normalize all text files to LF in the repo (Windows checkouts included).
# Prevents the CRLF churn that bloats diffs when edited on Windows.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Parallel pull requests each add a line to this list of path prefixes; a local rebase or merge
# keeps both sides' lines instead of stopping at a conflict (GitHub's own merge does not run this
# driver). The generator refuses a line out of order or listed twice, which a union merge can leave
# (see the note at the top of scripts/codegen/gen_pyright_test_environments.py).
scripts/codegen/pyright_tests_owing_any.txt merge=union
